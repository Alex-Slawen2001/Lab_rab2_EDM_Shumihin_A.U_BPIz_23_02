<!--
    Файл: MainWindow.xaml
    Назначение: Главное окно приложения.
                Содержит меню:
                  "Сотрудники" → открывает WindowEmployee
                  "Должности"  → открывает WindowRole
-->
<Window x:Class="Lab_rab2_EDM_Shumihin_A_U_BPIz_23_02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление сотрудниками (данные в БД — Entity Framework)" Height="350" Width="525">

    <Grid>
        <Menu>
            <MenuItem x:Name="Employee" Header="Сотрудники" Click="Employee_OnClick"/>
            <MenuItem x:Name="Role"     Header="Должности"  Click="Role_OnClick"/>
        </Menu>
    </Grid>
</Window>
