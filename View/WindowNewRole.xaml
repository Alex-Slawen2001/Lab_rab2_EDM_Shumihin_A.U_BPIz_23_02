<!--
    Файл: View/WindowNewRole.xaml
    Назначение: Диалоговое окно для добавления и редактирования должности.
                DataContext = объект Role (задаётся из RoleViewModel перед ShowDialog).
                Поле "Должность" привязано к Role.NameRole через двустороннее связывание.
                Кнопка "Сохранить" устанавливает DialogResult = true и закрывает окно.
                Кнопка "Отмена"   устанавливает DialogResult = false.
-->
<Window x:Class="Lab_rab2_EDM_Shumihin_A_U_BPIz_23_02.View.WindowNewRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Должность" Height="150" Width="300"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="10">

        <!-- Поле ввода наименования должности -->
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Должность:" Width="90"/>
            <!--
                Двустороннее связывание с Role.NameRole.
                UpdateSourceTrigger=PropertyChanged — обновляет модель сразу при вводе.
            -->
            <TextBox Width="160"
                     Text="{Binding NameRole, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <!-- Сохранить: устанавливает DialogResult = true -->
            <Button Content="Сохранить" Width="90" Margin="5,0"
                    Click="BtnSave_Click"/>
            <!-- Отмена: закрывает окно без сохранения -->
            <Button Content="Отмена" Width="90" Margin="5,0"
                    Click="BtnCancel_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
