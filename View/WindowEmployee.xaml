<!--
    Файл: View/WindowEmployee.xaml
    Назначение: Окно списка сотрудников с командами.
                DataContext = PersonViewModel (задаётся в code-behind).
                ListView.ItemsSource  → ListPerson (сотрудники из БД)
                ListView.SelectedItem → SelectedPerson (TwoWay)
                Должность выводится через навигационное свойство Role.NameRole
                (данные связанной таблицы Role подключены в запросе через Include).
-->
<Window x:Class="Lab_rab2_EDM_Shumihin_A_U_BPIz_23_02.View.WindowEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Сотрудники" Height="350" Width="550"
        WindowStartupLocation="CenterScreen">

    <StackPanel>

        <ListView x:Name="lvEmployee"
                  Height="265"
                  ItemsSource="{Binding ListPerson}"
                  SelectedItem="{Binding SelectedPerson, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="40"
                                        DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Фамилия" Width="100"
                                        DisplayMemberBinding="{Binding LastName}"/>
                        <GridViewColumn Header="Имя" Width="80"
                                        DisplayMemberBinding="{Binding FirstName}"/>
                        <!-- Role.NameRole — наименование должности из связанной таблицы Role -->
                        <GridViewColumn Header="Должность" Width="120"
                                        DisplayMemberBinding="{Binding Role.NameRole}"/>
                        <GridViewColumn Header="Дата рождения" Width="110"
                                        DisplayMemberBinding="{Binding Birthday, StringFormat={}{0:dd\.}{0:MM\.}{0:yyyy}}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Панель кнопок -->
        <StackPanel Orientation="Horizontal" Background="#FFE4E0E0">
            <Button Content="Добавить"
                    Height="25" Margin="10,10,5,10"
                    Command="{Binding AddPerson}"/>
            <Button Content="Редактировать"
                    Height="25" Margin="10,10,5,10"
                    Command="{Binding EditPerson}"/>
            <Button Content="Удалить"
                    Height="25" Margin="10,10,5,10"
                    Command="{Binding DeletePerson}"/>
        </StackPanel>

    </StackPanel>
</Window>
