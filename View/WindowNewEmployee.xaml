<!--
    Файл: View/WindowNewEmployee.xaml
    Назначение: Диалоговое окно для добавления и редактирования сотрудника.
                DataContext = объект Person (задаётся из PersonViewModel).
                ComboBox CbRole:
                  ItemsSource       — должности из БД (задаётся в code-behind)
                  DisplayMemberPath — NameRole (что показывать в списке)
                  SelectedValuePath — Id       (какое значение брать у выбранной должности)
                  SelectedValue     — {Binding RoleId} (куда записывать код должности)
-->
<Window x:Class="Lab_rab2_EDM_Shumihin_A_U_BPIz_23_02.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Сотрудник" Height="260" Width="340"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Код (для нового сотрудника = 0, его сформирует БД) -->
        <Label Grid.Row="0" Grid.Column="0" Content="Код:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Width="180" Height="22"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 IsReadOnly="True" Background="#FFEFEFEF"
                 Text="{Binding Id}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Фамилия:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Width="180" Height="22"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Имя:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Width="180" Height="22"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Должность:" VerticalAlignment="Center"/>
        <ComboBox x:Name="CbRole" Grid.Row="3" Grid.Column="1" Width="180" Height="22"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  DisplayMemberPath="NameRole"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding RoleId, Mode=TwoWay}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Дата рождения:" VerticalAlignment="Center"/>
        <DatePicker x:Name="ClBirthday" Grid.Row="4" Grid.Column="1" Width="180" Height="24"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    SelectedDate="{Binding Birthday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Сохранить" Width="90" Margin="5,0" IsDefault="True"
                    Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="90" Margin="5,0" IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
