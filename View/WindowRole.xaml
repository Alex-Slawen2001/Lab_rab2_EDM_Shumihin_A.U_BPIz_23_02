<!--
    Файл: View/WindowRole.xaml
    Назначение: Окно списка должностей с командами.
                DataContext = RoleViewModel (задаётся в code-behind).
                ListView.ItemsSource   → привязан к ListRole
                ListView.SelectedItem  → привязан к SelectedRole (двусторонняя)
                Кнопки:
                  "Добавить"      → Command="{Binding AddRole}"
                  "Редактировать" → Command="{Binding EditRole}"  (активна при выделении)
                  "Удалить"       → Command="{Binding DeleteRole}" (активна при выделении)
-->
<Window x:Class="Lab_rab2_EDM_Shumihin_A_U_BPIz_23_02.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Должности" Height="350" Width="350"
        WindowStartupLocation="CenterScreen">

    <StackPanel Background="#FFD8D8D8">

        <Label Margin="5" HorizontalAlignment="Center">
            Список должностей сотрудников
        </Label>

        <!--
            ListView:
              ItemsSource   = ListRole    — коллекция должностей
              SelectedItem  = SelectedRole — выбранная должность (Mode=TwoWay)
        -->
        <ListView x:Name="lvRole"
                  Background="#FFD3CDCD"
                  Height="230"
                  ItemsSource="{Binding ListRole}"
                  SelectedItem="{Binding SelectedRole, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="50"
                                        DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Наименование должности" Width="220"
                                        DisplayMemberBinding="{Binding NameRole}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Панель кнопок -->
        <StackPanel Orientation="Horizontal" Background="#FFE4E0E0">
            <!-- AddRole: всегда активна -->
            <Button Content="Добавить"
                    Height="25" Margin="10,10,5,10"
                    Command="{Binding AddRole}"/>

            <!-- EditRole: активна только при SelectedRole != null -->
            <Button Content="Редактировать"
                    Height="25" Margin="10,10,5,10"
                    Command="{Binding EditRole}"/>

            <!-- DeleteRole: активна только при SelectedRole != null -->
            <Button Content="Удалить"
                    Height="25" Margin="10,10,5,10"
                    Command="{Binding DeleteRole}"/>
        </StackPanel>

    </StackPanel>
</Window>
